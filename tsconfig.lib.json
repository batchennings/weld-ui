{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/components/**/*", "src/lib/**/*", "src/types/**/*", "index.ts"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.tsx", "src/mock/**/*", "src/pages/**/*", "src/stories/**/*"]
}

